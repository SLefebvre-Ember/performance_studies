; Start of the job file

; the global tag is not a job, it instantiates flags and data that are consistent throughout every test in the file
[global]
filename=storageTest
allow_file_create=1
size=5G
oiengine=sync
zero_buffers=1
direct=1
fdatasync=1
write_bw_log=bandwidth
numjobs=1
rw=read

